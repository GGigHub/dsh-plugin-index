{
  "name": "@dsh-external/dsh-plugin-index",
  "version": "0.1.0",
  "description": "DSH 插件索引：按 GitHub 星标浏览社区插件，并安装 / 卸载 / 更新 / 修复",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT",
  "keywords": ["dsh-plugin", "dsh", "deepseek-harness", "cordis"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGigHub/dsh-plugin-index.git"
  },
  "bugs": {
    "url": "https://github.com/GGigHub/dsh-plugin-index/issues"
  },
  "homepage": "https://github.com/GGigHub/dsh-plugin-index#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  }
}
